<Project>
  <!-- Shared build settings for every project (C# profile). The version is raised here only. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Product>XIV ConfigSync</Product>
    <Copyright>Copyright (C) 2026 Sanaka. GPL-3.0-or-later.</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 runs at build time only with the documentation file; CS1591 is the price (C# profile). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en;de</SatelliteResourceLanguages>
    <!-- Symbols inside the assemblies, so a published single file has nothing beside it (WPF profile). -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
